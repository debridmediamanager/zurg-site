# Copy to deploy.env and fill in. deploy.env is gitignored.

# Cloudflare Pages project name for `./deploy.sh pages`
CF_PAGES_PROJECT=zurg

# Settings for `./deploy.sh host`
ZURGSITE_HOST=user@box
ZURGSITE_PATH='~/zurgsite'          # quote a ~ so the remote expands it, not your shell
ZURGSITE_SERVICE=zurgsite.service   # optional, systemd --user unit to restart
ZURGSITE_HEALTH_URL=http://box:8080/  # optional, polled after the restart
